# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Whisper Speech-to-Text Settings
# Model options: 'tiny', 'base', 'small', 'medium', 'large'
WHISPER_MODEL_SIZE=base

# Local LLM Settings (Ollama)
LOCAL_LLM_ENDPOINT=http://localhost:11434/api/chat
LOCAL_LLM_MODEL=llama3.2:3b
LOCAL_LLM_TIMEOUT=120

# TTS (Text-to-Speech) Settings - Coqui TTS with XTTS v2
CLONETTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
CLONETTS_OUTPUT_FORMAT=wav
CLONETTS_LANGUAGE=en
# Note: CLONETTS_DEFAULT_SPEAKER_WAV is set to media/voice_profiles/default_voice.wav

# Audio Conversion
# FFmpeg is required for browser-recorded voice profiles (WebM to WAV conversion)
# Install: https://ffmpeg.org/download.html
# Verify with: ffmpeg -version

# TTS Backend Selection
# Options: 'piper' (fast, CPU-friendly) or 'coqui' (voice cloning, slower)
TTS_BACKEND=piper

# Piper TTS Settings (fast, CPU-optimized)
# Download models from: https://github.com/rhasspy/piper/releases
# Model and config must be in the same directory

# Chinese models (download from Piper releases)
PIPER_ZH_MODEL_PATH=media/piper_voices/zh_CN-huayan-medium.onnx
PIPER_ZH_CONFIG_PATH=media/piper_voices/zh_CN-huayan-medium.onnx.json

# English models
PIPER_EN_MODEL_PATH=media/piper_voices/en_US-lessac-medium.onnx
PIPER_EN_CONFIG_PATH=media/piper_voices/en_US-lessac-medium.onnx.json